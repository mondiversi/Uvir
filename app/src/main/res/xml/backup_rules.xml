<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="sharedpref" path="uvir_updates.xml" />
    <exclude domain="sharedpref" path="uvir_sensor_settings_pending.xml" />
    <!--
        Keep sensor authentication tokens and Wi-Fi, Bluetooth and MQTT
        credentials out of Android Auto Backup on Android 11 and earlier.
        Sensitive settings can still be transferred explicitly with Uvir's
        encrypted settings export.
    -->
    <exclude
        domain="sharedpref"
        path="uvir_sensor_credentials.xml" />
</full-backup-content>

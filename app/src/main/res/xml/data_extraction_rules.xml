<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="uvir_updates.xml" />
        <exclude domain="sharedpref" path="uvir_sensor_settings_pending.xml" />
        <!--
            Connection profiles contain sensor authentication tokens and
            Wi-Fi, Bluetooth and MQTT credentials. They must only move through
            Uvir's explicit encrypted settings export.
        -->
        <exclude
            domain="sharedpref"
            path="uvir_sensor_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="uvir_updates.xml" />
        <exclude domain="sharedpref" path="uvir_sensor_settings_pending.xml" />
        <exclude
            domain="sharedpref"
            path="uvir_sensor_credentials.xml" />
    </device-transfer>
</data-extraction-rules>

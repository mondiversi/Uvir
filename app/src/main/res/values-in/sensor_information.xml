    <string name="sensor_info_precision">Akurasi</string>
    <string name="sensor_info_precision_note">Setiap penggandaan penguatan menggandakan respons mentah terhadap cahaya lemah, tetapi kira-kira membagi dua ruang sebelum saturasi. Ini meningkatkan sensitivitas dan resolusi, bukan akurasi kalibrasi; satuan tampilan tidak berpengaruh.</string>
    <string name="sensor_info_status">Status</string>
    <string name="sensor_info_as7331_scale_pending">Firmware saat ini menggunakan profil pengukuran tetap dari driver; penyesuaian rentang otomatis belum aktif.</string>
    <string name="sensor_info_as7331_precision_note">Penguatan atau waktu konversi yang lebih besar meningkatkan resolusi UV lemah, tetapi mengurangi ruang sebelum saturasi. Tingkat otomatis yang tepat akan ditampilkan setelah validasi perangkat keras AS7331.</string>

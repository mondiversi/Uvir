    <string name="sensor_info_precision">דיוק</string>
    <string name="sensor_info_precision_note">כל הכפלה של ההגבר מכפילה את התגובה הגולמית לאור חלש, אך מקטינה בערך בחצי את המרווח לרוויה. הדבר משפר רגישות ורזולוציה, לא את דיוק הכיול; יחידת התצוגה אינה משפיעה.</string>
    <string name="sensor_info_status">מצב</string>
    <string name="sensor_info_as7331_scale_pending">הקושחה הנוכחית משתמשת בפרופיל המדידה הקבוע של מנהל ההתקן; התאמת טווח אוטומטית עדיין אינה פעילה.</string>
    <string name="sensor_info_as7331_precision_note">הגבר או זמן המרה גבוהים יותר ישפרו רזולוציה של UV חלש אך יקטינו את המרווח לרוויה. הרמות האוטומטיות המדויקות יוצגו לאחר אימות עם חומרת AS7331.</string>

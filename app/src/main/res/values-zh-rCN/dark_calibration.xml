<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="dark_offsets_calculate">计算偏移</string>
    <string name="dark_offsets_instructions">在稳定的参考条件下测量约30秒。进行暗参考测量时，请用也能阻挡近红外线的材料遮住光学输入，并让LED保持正常工作状态。在有光环境下，参考光也会被扣除，因此测量结果为相对值。此过程不校准增益。</string>
    <string name="dark_offsets_uv_method">对于UVC、UVB和UVA，建议使用各通道读数的平均值。紫外线增益会根据光照强度自动调整。</string>
    <string name="dark_offsets_visible_method">对于每个可见光/红外通道，建议使用读数的平均值。</string>
    <string name="dark_offsets_progress">测量中：%1$s / 30秒</string>
    <string name="dark_offsets_result">根据%1$s次读数提出的建议。尚未更改任何设置。</string>
    <string name="dark_offsets_failed">测量中断或不可用。请检查连接和传感器后重试。</string>
    <string name="dark_offsets_start">开始测量</string>
    <string name="dark_offsets_apply">应用偏移</string>
    <string name="dark_offsets_firmware_required">需要传感器固件0.5.110或更高版本。</string>
    <string name="calibration_reset_values">重置数值</string>
    <string name="calibration_reset_confirmation_title">重置数值？</string>
    <string name="calibration_reset_confirm_action">重置</string>
    <string name="calibration_reset_confirmation_message">将%1$s的校正系数重置为1，偏移重置为0。其他校准和光学窗口设置保持不变。</string>
    <string name="optical_window_reset_confirmation_message">将总体倍率和光学窗口所有通道倍率重置为1。校准保持不变。</string>
</resources>

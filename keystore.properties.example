# Optional per-PC overrides; normally the private Dropbox signing.properties is sufficient.
# Blank uses MONDIVERSI_SIGNING_DIR or ~/Dropbox/Mondiversi/UvirSigning.
# An explicit custom storeFile must be an absolute path, preferably using /.
storeFile=
storePassword=YOUR_PRIVATE_STORE_PASSWORD
keyAlias=uvir-release
keyPassword=YOUR_PRIVATE_KEY_PASSWORD
